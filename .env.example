# GigBid environment. Copy to .env and fill in. NEVER commit .env.
# Every variable the stack reads is listed here; none of these values are real secrets.

# ---------------------------------------------------------------- core / database
# Local dev default is SQLite; docker compose overrides with the postgres service.
DATABASE_URL=sqlite:///data/processed/gigbid.db
# Optional separate databases for LangGraph checkpoints and trace_events (default: DATABASE_URL)
CHECKPOINT_DATABASE_URL=
TRACE_DATABASE_URL=
POSTGRES_USER=gigbid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gigbid
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
# inline = FastAPI background task (single host / Vercel), worker = enqueue to Arq on Redis
RUN_MODE=inline
API_PORT=8000
WEB_PORT=8080
WEB_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
HEALTH_CACHE_SECONDS=
# Repository root override (defaults to the checkout)
GIGBID_ROOT=
# Arq worker limits
WORKER_MAX_JOBS=
WORKER_JOB_TIMEOUT=

# ---------------------------------------------------------------- auth / secrets
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_HOURS=
# Fernet key for the encrypted OAuth token store.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=
# Seeded reviewer account (reviewer@gigbid.app, persona aiml)
REVIEWER_PASSWORD=
# Shared secret for POST /api/cron/scout (scheduled scouting from an external cron)
CRON_SECRET=

# ---------------------------------------------------------------- LLM profile
# empty = use agent/config.yaml profile (open = Ollama); groq = deploy override; heuristic = no LLM (CI/tests)
LLM_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
# Space-separated list pulled by the ollama-pull init container
OLLAMA_MODELS_TO_PULL=qwen2.5:7b-instruct-q4_K_M
GROQ_API_KEY=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
# Override the agent config file / profile / model for experiments
GIGBID_AGENT_CONFIG=
GIGBID_PROFILE=
GIGBID_MODEL=
# Fixed "today" for reproducible evals (ISO date), empty = real clock
GIGBID_TODAY=
# Optional "paid" profile (OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------------------------------------------------------------- observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gigbid
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Public trace link template shown in the run viewer, e.g. https://smith.langchain.com/.../r/{run_id}
LANGSMITH_TRACE_URL_TEMPLATE=
# 1 = disable the trace_events callback
TRACING_DISABLED=0

# ---------------------------------------------------------------- marketplace
# gigsim = simulator (default) | upwork = official Upwork MCP server (live, drafts only)
MARKETPLACE_MODE=gigsim
GIGSIM_URL=http://localhost:8100
GIGSIM_PORT=8100
# How agents reach the marketplace: mcp (default, via the marketplace MCP server) | gigsim_http | memory (tests)
MARKETPLACE_PORT=mcp
GIGSIM_DATABASE_URL=sqlite:///data/processed/gigsim.db
GIGSIM_ERROR_RATE=0.02
GIGSIM_POLICY_UPDATE=1
GIGSIM_CLIENT_LLM=0
GIGSIM_SKIP_SEED=0
# GigSim bearer token for the active freelancer (gs-aiml-token | gs-fullstack-token | gs-data-token)
GIGSIM_TOKEN=gs-aiml-token
# Admin header value for POST /admin/tick (simulator only)
GIGSIM_ADMIN_KEY=gigsim-admin
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_OAUTH_METADATA_URL=
UPWORK_REDIRECT_URI=http://localhost:8080/api/auth/upwork/callback

# ---------------------------------------------------------------- MCP servers
# Leave URLs empty to run servers in-process (stdio / in-memory).
MCP_PORTFOLIO_URL=http://localhost:8201/mcp
MCP_MARKETPLACE_URL=http://localhost:8202/mcp
MCP_WORKSPACE_URL=http://localhost:8203/mcp
# Bearer tokens each MCP server requires over HTTP (clients send the same value).
# Multi-user form: MCP_<NAME>_TOKENS='{"token":"user_id"}'
MCP_PORTFOLIO_TOKEN=
MCP_MARKETPLACE_TOKEN=
MCP_WORKSPACE_TOKEN=
MCP_HOST=127.0.0.1
MCP_PORTFOLIO_PORT=8201
MCP_MARKETPLACE_PORT=8202
MCP_WORKSPACE_PORT=8203
# User id the MCP servers act for in stdio mode
MCP_USER_ID=
MCP_AUDIT_PATH=data/processed/audit.log
MCP_IDEMPOTENCY_PATH=
PORTFOLIO_PERSONA=aiml
# Portfolio retrieval backend: auto | keyword
PORTFOLIO_BACKEND=auto
PORTFOLIO_DATA_DIR=
WORKSPACE_PATH=data/processed/workspace.json
FASTEMBED_CACHE_PATH=data/processed/models

# ---------------------------------------------------------------- single-host deploy (Vercel)
# 1 = mount GigSim at /gigsim and the MCP servers at /mcp/* inside the API process
MOUNT_GIGSIM=0
MOUNT_MCP=0
# Public base URL of the deployment (used by the scheduled scout workflow)
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- scheduling
# Scout interval per saved search. Justification in docs/RUNBOOK.md.
SCOUT_INTERVAL_MINUTES=30
