            "title": "ScreeningAnswer",
            "type": "object"
          }
        },
        "properties": {
          "bid_amount": {
            "description": "Bid in USD (hourly rate or fixed total).",
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "title": "Bid Amount",
            "type": "number"
          },
          "cover_letter": {
            "description": "Cover letter text, 50-2500 characters.",
            "maxLength": 2500,
            "minLength": 50,
            "title": "Cover Letter",
            "type": "string"
          },
          "draft_id": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Draft this submission was approved from (for the audit trail).",
            "title": "Draft Id"
          },
          "dry_run": {
            "default": false,
            "description": "If true, return exactly what would be sent and what it costs; nothing is created, sent or spent.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "description": "Client-chosen unique key (8-128 chars). Retrying with the same key returns the first result and never submits or spends Connects twice.",
            "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "description": "Job to bid on.",
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
            "title": "Job Id",
            "type": "string"
          },
          "screening_answers": {
            "default": [],
            "description": "One answer per screening question.",
            "items": {
