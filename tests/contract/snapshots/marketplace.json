  "tools": {
    "create_proposal_draft": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Create proposal draft"
      },
      "description": "Save a proposal as a draft (nothing is sent, no Connects spent) and return its Connects cost. Requires idempotency_key; dry_run=true returns the preview without saving.",
      "inputSchema": {
        "$defs": {
          "ScreeningAnswer": {
            "properties": {
              "answer": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Answer",
                "type": "string"
              },
              "question": {
                "maxLength": 500,
                "minLength": 1,
                "title": "Question",
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "title": "ScreeningAnswer",
            "type": "object"
          }
        },
        "properties": {
          "bid_amount": {
            "description": "Bid in USD (hourly rate or fixed total).",
            "exclusiveMinimum": 0,
            "maximum": 100000,
            "title": "Bid Amount",
            "type": "number"
          },
          "cover_letter": {
            "description": "Cover letter text, 50-2500 characters.",
            "maxLength": 2500,
            "minLength": 50,
            "title": "Cover Letter",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "If true, return exactly what would be sent and what it costs; nothing is created, sent or spent.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "description": "Client-chosen unique key (8-128 chars). Retrying with the same key returns the first result and never submits or spends Connects twice.",
            "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "job_id": {
            "description": "Job to bid on.",
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
            "title": "Job Id",
            "type": "string"
          },
          "screening_answers": {
            "default": [],
            "description": "One answer per screening question.",
            "items": {
              "$ref": "#/$defs/ScreeningAnswer"
            },
            "maxItems": 10,
            "title": "Screening Answers",
            "type": "array"
          }
        },
        "required": [
          "job_id",
          "cover_letter",
          "bid_amount",
          "idempotency_key"
        ],
        "title": "create_proposal_draftArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "ProposalPayload": {
            "properties": {
              "bid_amount": {
                "title": "Bid Amount",
                "type": "number"
              },
              "cover_letter": {
                "title": "Cover Letter",
                "type": "string"
              },
              "job_id": {
                "title": "Job Id",
                "type": "string"
              },
              "screening_answers": {
                "items": {
                  "$ref": "#/$defs/ScreeningAnswer"
                },
                "title": "Screening Answers",
                "type": "array"
              }
            },
            "required": [
              "job_id",
              "cover_letter",
              "bid_amount"
            ],
            "title": "ProposalPayload",
            "type": "object"
          },
          "ScreeningAnswer": {
            "properties": {
              "answer": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Answer",
                "type": "string"
              },
              "question": {
                "maxLength": 500,
                "minLength": 1,
                "title": "Question",
                "type": "string"
              }
            },
            "required": [
              "question",
              "answer"
            ],
            "title": "ScreeningAnswer",
            "type": "object"
          }
        },
        "properties": {
          "balance_after": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Balance After"
          },
          "connects_cost": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Connects Cost"
          },
          "draft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Draft Id"
          },
          "dry_run": {
            "default": false,
            "title": "Dry Run",
            "type": "boolean"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "marketplace": {
            "title": "Marketplace",
            "type": "string"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "preview": {
            "$ref": "#/$defs/ProposalPayload"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "draft",
              "preview"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "job_id",
          "preview",
          "marketplace"
        ],
        "title": "DraftResult",
        "type": "object"
      }
    },
