    "send_message": {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Send message"
      },
      "description": "Send a reply in a client thread. Only after user approval. Requires idempotency_key; dry_run=true returns exactly what would be sent.",
      "inputSchema": {
        "properties": {
          "body": {
            "description": "Message text (1-5000 characters).",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "If true, return exactly what would be sent and what it costs; nothing is created, sent or spent.",
            "title": "Dry Run",
            "type": "boolean"
          },
          "idempotency_key": {
            "description": "Client-chosen unique key (8-128 chars). Retrying with the same key returns the first result and never submits or spends Connects twice.",
            "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
            "title": "Idempotency Key",
            "type": "string"
          },
          "thread_id": {
            "description": "Thread to reply in.",
            "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "body",
          "idempotency_key"
        ],
        "title": "send_messageArguments",
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "dry_run": {
            "default": false,
            "title": "Dry Run",
            "type": "boolean"
          },
          "marketplace": {
            "title": "Marketplace",
            "type": "string"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Message Id"
          },
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "replayed": {
            "default": false,
            "title": "Replayed",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "sent",
              "would_send",
              "draft_created"
            ],
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "would_send": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Would Send"
          }
        },
        "required": [
          "status",
          "thread_id",
          "marketplace"
        ],
        "title": "SendMessageResult",
        "type": "object"
      }
    },
    "submit_proposal": {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true,
        "readOnlyHint": false,
        "title": "Submit proposal"
      },
      "description": "Submit a proposal to a job; spends Connects. Only call after the user approved the dry_run preview. Requires idempotency_key (a retry with the same key never submits twice). In live Upwork mode this creates a draft the user confirms on Upwork.",
      "inputSchema": {
        "$defs": {
          "ScreeningAnswer": {
            "properties": {
              "answer": {
                "maxLength": 2000,
