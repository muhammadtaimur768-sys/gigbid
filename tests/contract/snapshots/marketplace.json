                "title": "Cover Letter",
                "type": "string"
              },
              "job_id": {
                "title": "Job Id",
                "type": "string"
              },
              "screening_answers": {
                "items": {
                  "$ref": "#/$defs/ScreeningAnswer"
                },
                "title": "Screening Answers",
                "type": "array"
              }
            },
            "required": [
